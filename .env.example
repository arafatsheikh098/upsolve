# Copy to .env and change the secret before running anywhere but your own machine.
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Services listen on this computer only. To open the web app to your local network
# (e.g. to try it from your phone), set WEB_BIND=0.0.0.0. Databases always stay local.
WEB_BIND=127.0.0.1
